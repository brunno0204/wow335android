-- ChrClasses.dbc: class token -> localized name (Constants.lua fills LOCALIZED_CLASS_NAMES_*).
local CLASS_FALLBACK = { WARRIOR = "Warrior", PALADIN = "Paladin", HUNTER = "Hunter", ROGUE = "Rogue",
